# Copy to .env and change the secrets before running docker compose on a shared machine.
POSTGRES_USER=medbook
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=medbook
# Staff page (/admin) and admin API token. Patients never need it.
MEDBOOK_ADMIN_TOKEN=change-this-token

# NLU: WITH_XLMR=1 bakes CPU torch into the image and uses the trained XLM-R model (results/*/model).
# Set WITH_XLMR=0 and MEDBOOK_NLU=baseline for a small image with the TF-IDF/CRF baseline.
WITH_XLMR=1
MEDBOOK_NLU=
# Voice input (Whisper). Spoken replies (TTS) also need WITH_XLMR=1, which brings torch.
WITH_VOICE=0
# large-v3-turbo: best on real Urdu speech (~1.6 GB download, ~1.5 GB RAM, ~5 s per message on 4 CPUs).
# Use small as the fallback on small machines.
MEDBOOK_WHISPER=large-v3-turbo
MEDBOOK_TTS=1
# 1 = load Whisper and TTS at start-up so the first voice message is not slow (only with WITH_VOICE=1)
MEDBOOK_VOICE_PRELOAD=0
# Backend worker processes. Each loads its own model copy (about 1 GB RAM with XLM-R).
WEB_CONCURRENCY=1

# Reminders: log (print and store only), webhook (POST JSON to your SMS gateway) or twilio.
MEDBOOK_REMINDER_PROVIDER=log
MEDBOOK_REMINDER_EVERY=300
MEDBOOK_SMS_WEBHOOK=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Dialogue manager: auto = LLM when a key below is set, else the rule-based manager (works offline).
# MEDBOOK_DM=llm or rules forces one. See backend/llm_agent.py.
MEDBOOK_DM=auto
# Claude (default provider). Haiku 5.5 is about $0.10 / $0.50 per million tokens in / out.
ANTHROPIC_API_KEY=
MEDBOOK_LLM_PROVIDER=anthropic
MEDBOOK_LLM_MODEL=claude-haiku-5-5
MEDBOOK_LLM_EFFORT=low
# Or any OpenAI-compatible server (Gemini, Groq, local Ollama): set MEDBOOK_LLM_PROVIDER=openai and
# MEDBOOK_LLM_BASE_URL=http://localhost:11434/v1  MEDBOOK_LLM_MODEL=qwen2.5:7b  MEDBOOK_LLM_API_KEY=
MEDBOOK_LLM_BASE_URL=
MEDBOOK_LLM_API_KEY=
